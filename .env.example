# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# CONFIGURACIÓN DE INDÓMITA LUZ (Completar con datos reales antes de publicar)
# ------------------------------------------------------------------
# Número de WhatsApp con código de país y área sin "+" ni espacios (ej: 549351XXXXXXX)
VITE_WHATSAPP_NUMBER=""

# Usuario de Instagram sin "@" (ej: indomitaluz.cba)
VITE_INSTAGRAM_HANDLE=""

# Correo electrónico de contacto y prensa
VITE_CONTACT_EMAIL=""

# Analítica (Opcional - dejar vacío hasta contar con los IDs reales)
VITE_GA4_MEASUREMENT_ID=""
VITE_GTM_ID=""
